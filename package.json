{
    "name": "vscode-extensions",
    "private": true,
    "description": "Monorepo for Gustaf Eriksson's VS Code extensions, managed with Bun workspaces.",
    "author": "Gustaf Eriksson",
    "license": "MIT",
    "packageManager": "bun@1.3.13",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "compile": "bun run --filter './packages/*' compile",
        "watch": "bun run --filter './packages/*' watch",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "package": "bun run compile && bun run --filter './packages/*' package"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.11",
        "@types/node": "18.x",
        "@types/vscode": "^1.89.0",
        "@vscode/vsce": "^3.2.0",
        "typescript": "^5.3.3"
    }
}
