{
    "name": "branch-pr-viewer",
    "displayName": "Branch PR Viewer",
    "description": "Review the checked-out branch's changes against its base like a GitHub PR's \"Files changed\", with native, editable diffs.",
    "version": "0.0.7",
    "publisher": "gustaferiksson",
    "author": "Gustaf Eriksson",
    "license": "MIT",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/gustaferiksson/vscode-extensions",
        "directory": "packages/branch-pr-viewer"
    },
    "engines": {
        "vscode": "^1.89.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "keywords": [
        "git",
        "branch",
        "diff",
        "pull request",
        "compare"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "branchPrViewerCurrent",
                    "title": "Current Branch Changes",
                    "icon": "media/pull-request.svg"
                }
            ]
        },
        "views": {
            "branchPrViewerCurrent": [
                {
                    "id": "branchPrViewer.currentChanges",
                    "name": "Changes",
                    "contextualTitle": "Current Branch Changes"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "branchPrViewer.currentChanges",
                "contents": "No Git repository was found in this workspace.\nOpen a folder that is under version control to review the current branch's changes."
            }
        ],
        "commands": [
            {
                "command": "branchPrViewer.refresh",
                "title": "Refresh",
                "category": "Branch PR Viewer",
                "icon": "$(refresh)"
            },
            {
                "command": "branchPrViewer.selectBase",
                "title": "Select Base Branch…",
                "category": "Branch PR Viewer",
                "icon": "$(git-compare)"
            },
            {
                "command": "branchPrViewer.openDiff",
                "title": "Open Diff",
                "category": "Branch PR Viewer"
            },
            {
                "command": "branchPrViewer.toggleDiffStyle",
                "title": "Toggle Diff Highlight Style",
                "category": "Branch PR Viewer",
                "icon": "$(color-mode)"
            },
            {
                "command": "branchPrViewer.openFile",
                "title": "Open File",
                "category": "Branch PR Viewer",
                "icon": "$(go-to-file)"
            },
            {
                "command": "branchPrViewer.viewAsList",
                "title": "View as List",
                "category": "Branch PR Viewer",
                "icon": "$(list-flat)"
            },
            {
                "command": "branchPrViewer.viewAsTree",
                "title": "View as Tree",
                "category": "Branch PR Viewer",
                "icon": "$(list-tree)"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "branchPrViewer.selectBase",
                    "when": "view == branchPrViewer.currentChanges",
                    "group": "navigation@1"
                },
                {
                    "command": "branchPrViewer.refresh",
                    "when": "view == branchPrViewer.currentChanges",
                    "group": "navigation@2"
                },
                {
                    "command": "branchPrViewer.toggleDiffStyle",
                    "when": "view == branchPrViewer.currentChanges",
                    "group": "navigation@3"
                },
                {
                    "command": "branchPrViewer.viewAsList",
                    "when": "view == branchPrViewer.currentChanges && config.branchPrViewer.viewMode == tree",
                    "group": "navigation@4"
                },
                {
                    "command": "branchPrViewer.viewAsTree",
                    "when": "view == branchPrViewer.currentChanges && config.branchPrViewer.viewMode == list",
                    "group": "navigation@4"
                }
            ],
            "commandPalette": [
                {
                    "command": "branchPrViewer.openDiff",
                    "when": "false"
                },
                {
                    "command": "branchPrViewer.openFile",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "branchPrViewer.openFile",
                    "when": "view == branchPrViewer.currentChanges && viewItem == file",
                    "group": "inline"
                }
            ]
        },
        "configuration": {
            "title": "Branch PR Viewer",
            "properties": {
                "branchPrViewer.baseBranch": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Branch to compare against, using three-dot (merge-base) diff like a GitHub PR. When empty, the base is detected automatically: `main`, then `master`."
                },
                "branchPrViewer.viewMode": {
                    "type": "string",
                    "enum": [
                        "tree",
                        "list"
                    ],
                    "enumDescriptions": [
                        "Group changed files into folders.",
                        "List changed files flat, sorted by path, with each file's folder beside its name."
                    ],
                    "default": "tree",
                    "markdownDescription": "How the **Current Branch Changes** view lays out changed files."
                },
                "branchPrViewer.diffStyle": {
                    "type": "string",
                    "enum": [
                        "theme",
                        "gutter"
                    ],
                    "enumDescriptions": [
                        "Leave diff colours to the colour theme (full line/word backgrounds); uncommitted lines still get a blue gutter stripe.",
                        "Hide the diff line backgrounds and mark changed lines with a thin gutter stripe beside the line numbers instead: green for committed, blue for uncommitted, red for removed."
                    ],
                    "default": "theme",
                    "markdownDescription": "How changed lines are highlighted in diff editors. `gutter` switches the diff line backgrounds off by writing colour IDs into your user `workbench.colorCustomizations` — which affects **every** diff editor — and replaces them with a thin gutter stripe in this extension's own diffs."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package --no-dependencies"
    }
}
